{
  "rules": {
    "stores": {
      "shared": {
        ".read": "auth != null && (root.child('allowedUsers').child(auth.uid).val() === true || root.child('allowedUsers').child(auth.uid).child('role').val() === 'user' || root.child('allowedUsers').child(auth.uid).child('role').val() === 'admin')",
        ".write": "auth != null && (root.child('allowedUsers').child(auth.uid).val() === true || root.child('allowedUsers').child(auth.uid).child('role').val() === 'user' || root.child('allowedUsers').child(auth.uid).child('role').val() === 'admin')"
      }
    },
    "allowedUsers": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid"
      },
      ".write": false
    }
  }
}
